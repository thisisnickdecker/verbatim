{
  "manifest_version": 3,
  "name": "Verbatim",
  "version": "0.5.0",
  "description": "Save ChatGPT and Claude conversations, YouTube and Spotify transcripts, or any web page, as clean Markdown, verified complete. Runs entirely in your browser.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Capture with Verbatim",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/settings/options.html",
    "open_in_tab": true
  }
}
